{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/entities/*/*",
                  "@/entities/*/**",
                  "@/features/*/*",
                  "@/features/*/**",
                  "@/widgets/*/*",
                  "@/widgets/*/**",
                  "@/pages/*/*",
                  "@/pages/*/**"
                ],
                "message": "FSD: импортируй слайс только через публичный index.ts (например, '@/entities/plan')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**"],
                "message": "FSD: слой «pages» не может импортировать вышележащие слои (app)."
              },
              {
                "group": [
                  "@/entities/*/*",
                  "@/entities/*/**",
                  "@/features/*/*",
                  "@/features/*/**",
                  "@/widgets/*/*",
                  "@/widgets/*/**",
                  "@/pages/*/*",
                  "@/pages/*/**"
                ],
                "message": "FSD: импортируй слайс только через публичный index.ts (например, '@/entities/plan')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/pages", "@/pages/**"],
                "message": "FSD: слой «widgets» не может импортировать вышележащие слои (app, pages)."
              },
              {
                "group": [
                  "@/entities/*/*",
                  "@/entities/*/**",
                  "@/features/*/*",
                  "@/features/*/**",
                  "@/widgets/*/*",
                  "@/widgets/*/**",
                  "@/pages/*/*",
                  "@/pages/*/**"
                ],
                "message": "FSD: импортируй слайс только через публичный index.ts (например, '@/entities/plan')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app",
                  "@/app/**",
                  "@/pages",
                  "@/pages/**",
                  "@/widgets",
                  "@/widgets/**"
                ],
                "message": "FSD: слой «features» не может импортировать вышележащие слои (app, pages, widgets)."
              },
              {
                "group": [
                  "@/entities/*/*",
                  "@/entities/*/**",
                  "@/features/*/*",
                  "@/features/*/**",
                  "@/widgets/*/*",
                  "@/widgets/*/**",
                  "@/pages/*/*",
                  "@/pages/*/**"
                ],
                "message": "FSD: импортируй слайс только через публичный index.ts (например, '@/entities/plan')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app",
                  "@/app/**",
                  "@/pages",
                  "@/pages/**",
                  "@/widgets",
                  "@/widgets/**",
                  "@/features",
                  "@/features/**"
                ],
                "message": "FSD: слой «entities» не может импортировать вышележащие слои (app, pages, widgets, features)."
              },
              {
                "group": [
                  "@/entities/*/*",
                  "@/entities/*/**",
                  "@/features/*/*",
                  "@/features/*/**",
                  "@/widgets/*/*",
                  "@/widgets/*/**",
                  "@/pages/*/*",
                  "@/pages/*/**"
                ],
                "message": "FSD: импортируй слайс только через публичный index.ts (например, '@/entities/plan')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app",
                  "@/app/**",
                  "@/pages",
                  "@/pages/**",
                  "@/widgets",
                  "@/widgets/**",
                  "@/features",
                  "@/features/**",
                  "@/entities",
                  "@/entities/**"
                ],
                "message": "FSD: слой «shared» не может импортировать вышележащие слои (app, pages, widgets, features, entities)."
              }
            ]
          }
        ]
      }
    }
  ]
}
